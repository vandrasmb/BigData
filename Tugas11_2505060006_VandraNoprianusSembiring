    "    \"qty\": np.random.randint(1, 6, size=n),\n",
    "    \"harga_satuan\": np.random.choice([15000, 18000, 20000, 22000, 25000, 30000], size=n),\n",
    "})\n",
    "data_tugas11[\"total_penjualan\"] = data_tugas11[\"qty\"] * data_tugas11[\"harga_satuan\"] + np.random.normal(0, 8000, size=n)\n",
    "data_tugas11.to_csv(\"tugas11_penjualan.csv\", index=False)\n",
