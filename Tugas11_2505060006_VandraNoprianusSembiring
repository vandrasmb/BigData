   "source": [
    "from pyspark.ml.feature import StringIndexer, VectorAssembler\n",
    "\n",
    "# Fit StringIndexer pada masing-masing kolom kategorikal dan simpan modelnya (dipakai lagi di Bagian E)\n",
    "indexer_menu = StringIndexer(inputCol=\"nama_menu\", outputCol=\"nama_menu_idx\")\n",
    "indexer_cabang = StringIndexer(inputCol=\"cabang\", outputCol=\"cabang_idx\")\n",
    "indexer_waktu = StringIndexer(inputCol=\"waktu_pesan\", outputCol=\"waktu_pesan_idx\")\n",
    "\n",
    "model_idx_menu = indexer_menu.fit(df)\n",
    "model_idx_cabang = indexer_cabang.fit(df)\n",
    "model_idx_waktu = indexer_waktu.fit(df)\n",
    "\n",
    "df_indexed = model_idx_menu.transform(df)\n",
    "df_indexed = model_idx_cabang.transform(df_indexed)\n",
    "df_indexed = model_idx_waktu.transform(df_indexed)\n",
    "\n",
    "df_indexed.select(\"nama_menu\", \"nama_menu_idx\", \"cabang\", \"cabang_idx\", \"waktu_pesan\", \"waktu_pesan_idx\").show(8)\n",
    "\n",
    "assembler = VectorAssembler(\n",
    "    inputCols=[\"qty\", \"harga_satuan\", \"nama_menu_idx\", \"cabang_idx\", \"waktu_pesan_idx\"],\n",
    "    outputCol=\"features\"\n",
    ")\n",
    "df_final = assembler.transform(df_indexed)\n",
    "df_final.select(\"features\", \"total_penjualan\").show(5, truncate=False)"
   ]
